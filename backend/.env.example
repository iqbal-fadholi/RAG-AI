PORT=3000

# ==========================================
# LLM & Embeddings Provider Selection
# ==========================================
# Options: "gemini" | "openai"
LLM_PROVIDER="gemini"
EMBEDDING_PROVIDER="gemini"

# ==========================================
# Google Gemini Configuration
# ==========================================
# Required if LLM_PROVIDER="gemini" or EMBEDDING_PROVIDER="gemini"
GOOGLE_API_KEY="your_gemini_api_key_here"
GOOGLE_MODEL="gemini-3.1-flash-lite"

# ==========================================
# OpenAI / OpenAI-Compatible Configuration
# ==========================================
# Required if LLM_PROVIDER="openai" or EMBEDDING_PROVIDER="openai"
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSIONS=1536

# Custom OpenAI-Compatible Base URL (Optional)
# Examples:
# - Ollama:     OPENAI_BASE_URL="http://localhost:11434/v1"  (or "http://host.docker.internal:11434/v1")
# - Groq:       OPENAI_BASE_URL="https://api.groq.com/openai/v1"
# - DeepSeek:   OPENAI_BASE_URL="https://api.deepseek.com/v1"
# - vLLM:       OPENAI_BASE_URL="http://localhost:8000/v1"
# - LM Studio:  OPENAI_BASE_URL="http://localhost:1234/v1"
# OPENAI_BASE_URL=""

# ==========================================
# Services & Database
# ==========================================
DOCLING_SERVICE_URL="http://docling-service:8000"

DB_HOST=pgvector
DB_PORT=5432
DB_USER=raguser
DB_PASSWORD=ragpassword
DB_NAME=rag_db

# ==========================================
# LangSmith (Optional Tracing)
# ==========================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your_langsmith_api_key_here"
LANGCHAIN_PROJECT="rag-mvp"

